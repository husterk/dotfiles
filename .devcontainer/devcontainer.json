{
    "name": "dotfiles-devcontainer",
    "dockerComposeFile": ["./docker-compose.devcontainer.yml"],
    "service": "devcontainer",
    "workspaceFolder": "/workspace",
    "features": {
        "ghcr.io/flexwie/devcontainer-features/op:1": {}
    },
    "containerUser": "vscode",
    "remoteUser": "vscode",
    "remoteEnv": {
        "ENV_DEVCONTAINER_USER": "vscode",
        "HOST_USER": "${localEnv:USER}"
    },
    "initializeCommand": "${localWorkspaceFolder}/.devcontainer/initialize.sh",
    "postCreateCommand": "ln -sf /home/vscode/.ssh-host /home/vscode/.ssh && bun install --frozen-lockfile && echo 'Devcontainer created successfully'",
    "postStartCommand": "echo 'Devcontainer started successfully'",
    "customizations": {
        "vscode": {
            "settings": {
                "files.associations": {
                    "*.env": "properties",
                    "*.env.template": "properties",
                    "*.env.*.template": "properties",
                    "*.env.tpl": "properties",
                    "*.env.*.tpl": "properties"
                },
                "terminal.integrated.profiles.linux": {
                    "zsh": {
                        "path": "zsh",
                        "args": ["-l"]
                    },
                    "zsh (host)": {
                        "path": "/workspace/.devcontainer/ssh-to-host.sh",
                        "icon": "terminal-bash"
                    }
                },
                "terminal.integrated.defaultProfile.linux": "zsh",
                "workbench.startupEditor": "none"
            },
            "extensions": [
                "1Password.op-vscode",
                "ms-azuretools.vscode-docker",
                "be5invis.toml",
                "bierner.markdown-preview-github-styles",
                "esbenp.prettier-vscode",
                "medo64.render-crlf",
                "bierner.markdown-mermaid",
                "oven.bun-vscode",
                "bbenoist.nix",
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "EditorConfig.EditorConfig"
            ]
        }
    }
}
