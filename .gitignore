# Don't commit any *.env files. These files are expected to
# be generated or manually created on the developer machine.
**/.env
.env

# Don't commit local Mac OS cache files
.DS_Store

# Ignore generated output: dotfiles rendered from templates and the .env
# derived from host-vars.toml. It is rebuilt on every generate.
**/generated

# Ignore symlinks to generated dotfiles (created during deployment)
hosts/**/.config

# mise task runner state
.task/

# Claude Code per-project local overrides only (shared project config
# lives at .claude/settings.json, commands/, agents/, etc.)
.claude/settings.local.json

# Nix build results
result
result-*
