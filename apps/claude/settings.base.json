{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoUpdatesChannel": "latest",
  "autoContinueAtUsageLimit": true,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "model": "claude-opus-5-5",
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(bat *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(statix *)",
      "Bash(treefmt *)",
      "Bash(mise run dev:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Edit(/private/tmp/claude-*/**)",
      "Bash(cf cli search *)",
      "Bash(cf schema *)",
      "Bash(cf auth whoami)",
      "Bash(cf * --help)",
      "Bash(cf zones settings edit *)",
      "Bash(cf rulesets account-rulesets update *)",
      "Bash(cf dns records create *)",
      "Bash(cf dns records edit *)",
      "Bash(cf dns records update *)",
      "Bash(cf dns dnssec edit *)",
      "Bash(cf workers deployments create *)"
    ],
    "ask": [],
    "deny": [
      "Edit(hosts/*/generated/**)",
      "Read(**/*.key)",
      "Read(**/id_ed25519)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(mkfs *)",
      "Bash(diskutil erase*)",
      "Bash(gh repo delete *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 1,
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: github.com/husterk and every repository under it. The owner works across these repositories from any session, so pushes, pull requests, issues, releases and workflow runs on them are routine.",
      "Trusted domains: keithhuster.com, ibuyhappiness.com and keithandlindsey.com, plus their *.pages.dev and *.workers.dev preview and production hosts. These are the owner's own sites.",
      "CI/CD deploy targets: GitHub Actions workflows in husterk repositories deploy the owner's sites to the owner's Cloudflare account. Triggering or re-running those workflows at the owner's request is routine."
    ],
    "allow": [
      "$defaults",
      "Committing, pushing and opening PRs for changes to apps/claude/settings.base.json in the husterk/dotfiles repository is allowed; the change only takes effect after the owner runs mise run refresh."
    ]
  }
}
