{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>husterk/.github//renovate/default#v2.1.2",
    "github>husterk/.github//renovate/mise#v2.1.2"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Nix flake inputs",
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "description": "Group mise CLI utilities",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "jq",
        "aqua:1password/cli",
        "yq",
        "aqua:neovim/neovim",
        "bats"
      ],
      "groupName": "mise cli tools"
    }
  ]
}
