{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>husterk/.github//renovate/default#v2.1.2",
    "github>husterk/.github//renovate/mise#v2.1.2"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Nix flake inputs",
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "description": "Group mise CLI utilities",
      "matchManagers": ["mise"],
      "matchDepNames": ["yq", "bats"],
      "groupName": "mise cli tools"
    },
    {
      "description": "Nix installs these too, and mise pins them to the version Nix provides so the repo and the system run the same binary. They move with mise run nix:update, which dev:check-tool-sync enforces.",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:1password/cli", "aqua:neovim/neovim", "jq"],
      "enabled": false
    }
  ]
}
