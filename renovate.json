{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>husterk/.github//renovate/default#v2.0.0",
    "github>husterk/.github//renovate/mise#v2.0.0"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Nix flake inputs",
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "description": "Group mise CLI utilities",
      "matchManagers": ["mise"],
      "matchDepNames": ["jq", "op", "yq", "aqua:neovim/neovim", "bats"],
      "groupName": "mise cli tools"
    }
  ],
  "mise": {
    "managerFilePatterns": ["/(^|/)apps/mise/dotfiles/config\\.toml$/"]
  }
}
